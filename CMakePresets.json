{
  "version": 7,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 3
  },
  "configurePresets": [
    {
      "name": "GCC-linux-x64-Ninja",
      "displayName": "GCC-linux-x64-Ninja",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_MAKE_PROGRAM": "ninja",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/thirdparty/vcpkg/scripts/buildsystems/vcpkg.cmake"
      },
      "warnings": {
        "dev": false,
        "systemVars": true,
        "uninitialized": true,
        "unusedCli": true,
        "deprecated": true
      },
      "errors": {
        "dev": false,
        "deprecated": true
      }
    },
    {
      "name": "Clang-linux-x64-Ninja",
      "displayName": "Clang-linux-x64-Ninja",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_MAKE_PROGRAM": "ninja",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/thirdparty/vcpkg/scripts/buildsystems/vcpkg.cmake"
      },
      "warnings": {
        "dev": false,
        "systemVars": true,
        "uninitialized": true,
        "unusedCli": true,
        "deprecated": true
      },
      "errors": {
        "dev": false,
        "deprecated": true
      }
    },
    {
      "name": "MSVC-2022-x64-Ninja",
      "displayName": "MSVC-2022-x64-Ninja",
      "generator": "Ninja Multi-Config",
      "toolset": {
        "value": "v143,host=x64",
        "strategy": "external"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "VCPKG_HOST_TRIPLET": "x64-windows",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe",
        "CMAKE_MAKE_PROGRAM": "ninja",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/thirdparty/vcpkg/scripts/buildsystems/vcpkg.cmake"
      },
      "warnings": {
        "dev": false,
        "systemVars": true,
        "uninitialized": true,
        "unusedCli": true,
        "deprecated": true
      },
      "errors": {
        "dev": false,
        "deprecated": true
      }
    }
  ],
  "buildPresets": [
